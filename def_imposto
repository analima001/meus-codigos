def calcular_imposto(valor):
    if valor >= 4664.68:
        imposto = valor * 0.275

    elif valor >= 3751.06:
        imposto = valor * 0.225

    elif valor >= 2826.66:
        imposto = valor * 0.15

    elif valor >= 2428.81:
        imposto = valor * 0.075

    else:
        imposto = 0
    return imposto

